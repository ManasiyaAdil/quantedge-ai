# ==============================================================================
# QuantEdge AI / SmartQuant Edge — Production Environment Variables Template
# ==============================================================================
# Security Notice:
# NEVER commit real credentials, API keys, or secrets into git or public repositories.
# In production (Vercel), add these variables in: Project Settings -> Environment Variables.
# The application runs safely without any credentials in institutional DEMO / PAPER mode.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BROKER INTEGRATIONS (SERVER-SIDE ONLY)
# ------------------------------------------------------------------------------
# Optional for preview/demo, Mandatory ONLY if you want live streaming ticks from Groww:
# Generate from https://groww.in developer portal
GROWW_API_KEY=
GROWW_API_SECRET=

# Optional for preview/demo, Mandatory ONLY if you want live streaming ticks from DhanHQ:
# Generate personal Web Access Token from https://dhanhq.co -> Profile -> Access Token
DHAN_CLIENT_ID=
DHAN_ACCESS_TOKEN=

# ------------------------------------------------------------------------------
# 2. OTP AUTHENTICATION SETTINGS (SERVER-SIDE ONLY - OPTIONAL)
# ------------------------------------------------------------------------------
# Validity period of one-time login verification codes in seconds (default: 60)
OTP_EXPIRY_SECONDS=60

# Minimum wait time between consecutive resend requests in seconds (default: 30)
OTP_RESEND_COOLDOWN_SECONDS=30

# Maximum permitted incorrect verification code attempts before lockout (default: 3)
OTP_MAX_ATTEMPTS=3

